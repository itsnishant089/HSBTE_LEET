{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/analytics-dashboard",
      "destination": "/html/analytics-dashboard.html"
    },
    {
      "source": "/:path((?!api|_next|.*\\..*|image|css|js|pdf|paper|syllabus).*)",
      "destination": "/html/:path.html"
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ]
}
