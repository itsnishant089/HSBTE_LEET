{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/analytics-dashboard",
      "destination": "/html/analytics-dashboard.html"
    },
    {
      "source": "/:path((?!api|_next|.*\\..*|image|css|js|pdf|paper|syllabus|html|data|partials|node_modules).*)",
      "destination": "/html/:path.html"
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/html/:path",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/:path.html",
      "destination": "/:path",
      "permanent": true
    }
  ]
}
