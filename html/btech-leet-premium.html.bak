  <style>
    /* ── PREMIUM PAGE STYLES ── */
    :root {
      --prem-gold: #f59e0b;
      --prem-gold-light: #fef3c7;
      --prem-blue: #1a56db;
      --prem-blue-dark: #1240a8;
      --prem-green: #10b981;
      --prem-red: #ef4444;
      --prem-bg: #f8fafc;
      --prem-text: #1e293b;
    }
    body.dark-mode { --prem-bg: #0f172a; --prem-text: #e2e8f0; }

    .premium-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1a3a6e 50%, #1a56db 100%);
      color: #fff;
      padding: 60px 20px 70px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .premium-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(245,158,11,0.12) 0, transparent 70%);
      pointer-events: none;
    }
    .premium-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: rgba(245,158,11,0.18);
      border: 1.5px solid #f59e0b;
      color: #fcd34d;
      border-radius: 999px;
      padding: 7px 18px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }
    .premium-hero h1 {
      font-size: clamp(1.7rem, 4vw, 2.8rem);
      font-weight: 900;
      line-height: 1.2;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }
    .premium-hero h1 span { color: #fcd34d; }
    .premium-hero p.hero-sub {
      font-size: clamp(1rem, 2.2vw, 1.2rem);
      opacity: 0.88;
      max-width: 620px;
      margin: 0 auto 32px;
      line-height: 1.65;
    }
    .hero-cta-wrap { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .btn-premium-cta {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 16px 34px;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      text-decoration: none;
      border: none;
      transition: all 0.22s ease;
      letter-spacing: 0.01em;
    }
    .btn-premium-cta.primary {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #0f172a;
      box-shadow: 0 6px 24px rgba(245,158,11,0.4);
    }
    .btn-premium-cta.primary:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(245,158,11,0.5); }
    .btn-premium-cta.secondary {
      background: rgba(255,255,255,0.12);
      color: #fff;
      border: 1.5px solid rgba(255,255,255,0.3);
    }
    .btn-premium-cta.secondary:hover { background: rgba(255,255,255,0.2); }

    /* Scarcity bar */
    .scarcity-bar {
      background: linear-gradient(90deg, #ef4444, #dc2626);
      color: #fff;
      text-align: center;
      padding: 10px 20px;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.03em;
    }
    .scarcity-bar .blink { animation: blink 1s step-end infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    /* Features section */
    .premium-section { padding: 60px 20px; background: var(--prem-bg); }
    .section-title {
      text-align: center;
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 800;
      color: var(--prem-text);
      margin-bottom: 10px;
    }
    .section-sub { text-align: center; color: #64748b; font-size: 1rem; margin-bottom: 44px; }
    body.dark-mode .section-sub { color: #94a3b8; }

    /* Why choose grid */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 22px;
      max-width: 1100px;
      margin: 0 auto;
    }
    .feature-card {
      background: #fff;
      border-radius: 16px;
      padding: 28px 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.07);
      border: 1px solid #e2e8f0;
      transition: transform 0.22s, box-shadow 0.22s;
    }
    body.dark-mode .feature-card { background: #1e293b; border-color: #334155; }
    .feature-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.12); }
    .feature-icon {
      width: 54px; height: 54px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 18px;
    }
    .feature-card h3 { font-size: 1.05rem; font-weight: 700; color: var(--prem-text); margin-bottom: 8px; }
    .feature-card p { font-size: 14px; color: #64748b; line-height: 1.65; }
    body.dark-mode .feature-card p { color: #94a3b8; }

    /* Comparison table */
    .compare-section { padding: 60px 20px; background: #fff; }
    body.dark-mode .compare-section { background: #0f172a; }
    .compare-table-wrap { max-width: 700px; margin: 0 auto; overflow-x: auto; }
    .compare-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14.5px;
    }
    .compare-table th, .compare-table td {
      padding: 14px 18px;
      text-align: center;
      border-bottom: 1px solid #e2e8f0;
    }
    body.dark-mode .compare-table th, body.dark-mode .compare-table td { border-color: #334155; }
    .compare-table th:first-child, .compare-table td:first-child { text-align: left; }
    .compare-table thead th { font-weight: 800; background: #f8fafc; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; }
    body.dark-mode .compare-table thead th { background: #1e293b; color: #e2e8f0; }
    .compare-table th.premium-col { background: linear-gradient(135deg, #1a3a6e, #1a56db); color: #fff; border-radius: 10px 10px 0 0; }
    .compare-table .check { color: #10b981; font-size: 1.1rem; }
    .compare-table .cross { color: #ef4444; font-size: 1.1rem; }
    .compare-table tr:hover td { background: #f8fafc; }
    body.dark-mode .compare-table tr:hover td { background: #1e293b; }

    /* Pricing card */
    .pricing-section { padding: 60px 20px; background: var(--prem-bg); }
    .pricing-card {
      max-width: 460px;
      margin: 0 auto;
      background: linear-gradient(145deg, #0f172a, #1a3a6e);
      border-radius: 24px;
      padding: 40px 36px;
      text-align: center;
      color: #fff;
      box-shadow: 0 20px 60px rgba(26,86,219,0.3);
      border: 1px solid rgba(245,158,11,0.25);
      position: relative;
      overflow: hidden;
    }
    .pricing-card::before {
      content: '';
      position: absolute;
      top: -60px; right: -60px;
      width: 200px; height: 200px;
      background: radial-gradient(circle, rgba(245,158,11,0.12), transparent);
      pointer-events: none;
    }
    .price-tag { font-size: 4rem; font-weight: 900; color: #fcd34d; line-height: 1; }
    .price-tag sup { font-size: 1.5rem; vertical-align: super; }
    .price-old { text-decoration: line-through; color: rgba(255,255,255,0.45); font-size: 1.1rem; margin-bottom: 6px; }
    .pricing-card h3 { font-size: 1.4rem; font-weight: 800; margin-bottom: 12px; margin-top: 16px; }
    .pricing-features { list-style: none; padding: 0; margin: 20px 0 28px; text-align: left; }
    .pricing-features li {
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      font-size: 14.5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .pricing-features li:last-child { border-bottom: none; }
    .pricing-features li i { color: #fcd34d; flex-shrink: 0; }
    .btn-buy {
      display: block;
      width: 100%;
      padding: 17px;
      border-radius: 50px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #0f172a;
      font-size: 1.05rem;
      font-weight: 900;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.22s;
      letter-spacing: 0.02em;
      box-shadow: 0 6px 24px rgba(245,158,11,0.4);
    }
    .btn-buy:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(245,158,11,0.55); }
    .seats-left {
      margin-top: 14px;
      font-size: 13px;
      color: #fca5a5;
      font-weight: 600;
    }
    .seats-left strong { color: #ef4444; }

    /* WhatsApp CTA */
    .whatsapp-section {
      background: linear-gradient(135deg, #0f172a, #1a3a6e);
      padding: 50px 20px;
      text-align: center;
      color: #fff;
    }
    .whatsapp-card {
      max-width: 560px;
      margin: 0 auto;
    }
    .whatsapp-card h2 { font-size: 1.7rem; font-weight: 800; margin-bottom: 12px; }
    .whatsapp-card p { opacity: 0.85; line-height: 1.65; margin-bottom: 28px; font-size: 1rem; }
    .btn-whatsapp {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 15px 32px;
      border-radius: 50px;
      background: #25d366;
      color: #fff;
      font-size: 1rem;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 6px 24px rgba(37,211,102,0.4);
      transition: all 0.22s;
    }
    .btn-whatsapp:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(37,211,102,0.55); }
    .btn-whatsapp i { font-size: 1.3rem; }

    /* Paper preview cards */
    .papers-section { padding: 60px 20px; background: #fff; }
    body.dark-mode .papers-section { background: #0f172a; }
    .papers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 18px;
      max-width: 900px;
      margin: 0 auto;
    }
    .paper-card {
      background: linear-gradient(145deg, #f8fafc, #e8f0fe);
      border-radius: 14px;
      padding: 26px 18px;
      text-align: center;
      border: 2px solid #e2e8f0;
      position: relative;
      transition: all 0.22s;
    }
    body.dark-mode .paper-card { background: linear-gradient(145deg, #1e293b, #1a3a6e); border-color: #334155; }
    .paper-card:hover { transform: translateY(-4px); border-color: var(--prem-blue); box-shadow: 0 8px 24px rgba(26,86,219,0.14); }
    .paper-number { font-size: 2rem; font-weight: 900; color: var(--prem-blue); display: block; }
    .paper-label { font-size: 13px; color: #64748b; margin-top: 6px; }
    body.dark-mode .paper-label { color: #94a3b8; }
    .paper-lock { position: absolute; top: 10px; right: 10px; color: #f59e0b; font-size: 14px; }

    /* Section tag styles */
    .section-tag {
      display: inline-block;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      padding: 3px 10px;
      border-radius: 999px;
      margin-bottom: 10px;
    }
    .paper-card.section-a { border-color: #818cf8; }
    .paper-card.section-a .paper-number { color: #6366f1; }
    .paper-card.section-a .section-tag { background: #eef2ff; color: #4338ca; }
    .paper-card.section-b { border-color: #34d399; }
    .paper-card.section-b .paper-number { color: #059669; }
    .paper-card.section-b .section-tag { background: #d1fae5; color: #065f46; }
    .paper-card.section-c { border-color: #f97316; }
    .paper-card.section-c .paper-number { color: #ea580c; }
    .paper-card.section-c .section-tag { background: #ffedd5; color: #9a3412; }
    .paper-card.section-d { border-color: #e879f9; }
    .paper-card.section-d .paper-number { color: #a21caf; }
    .paper-card.section-d .section-tag { background: #fae8ff; color: #86198f; }
    .paper-card.section-full { border-color: #f59e0b; }
    .paper-card.section-full .paper-number { color: #d97706; }
    .paper-card.section-full .section-tag { background: #fef3c7; color: #92400e; }
    body.dark-mode .paper-card.section-a .section-tag { background: #312e81; color: #a5b4fc; }
    body.dark-mode .paper-card.section-b .section-tag { background: #064e3b; color: #6ee7b7; }
    body.dark-mode .paper-card.section-c .section-tag { background: #7c2d12; color: #fed7aa; }
    body.dark-mode .paper-card.section-d .section-tag { background: #4a044e; color: #f0abfc; }
    body.dark-mode .paper-card.section-full .section-tag { background: #451a03; color: #fde68a; }

    /* FAQ */
    .faq-section { padding: 60px 20px; background: var(--prem-bg); }
    .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
    .faq-item {
      background: #fff;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      overflow: hidden;
    }
    body.dark-mode .faq-item { background: #1e293b; border-color: #334155; }
    .faq-q {
      padding: 18px 22px;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--prem-text);
      user-select: none;
    }
    .faq-q i { transition: transform 0.22s; color: var(--prem-blue); font-size: 13px; flex-shrink: 0; }
    .faq-item.open .faq-q i { transform: rotate(180deg); }
    .faq-a {
      padding: 0 22px;
      font-size: 14px;
      color: #64748b;
      line-height: 1.7;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease;
    }
    body.dark-mode .faq-a { color: #94a3b8; }
    .faq-item.open .faq-a { max-height: 200px; padding: 0 22px 18px; }

    @media (max-width: 600px) {
      .premium-hero { padding: 44px 16px 54px; }
      .pricing-card { padding: 28px 20px; }
    }
  </style>
</head>
<body>

<!-- HEADER -->
<div data-include="../partials/header.html"></div>

<main id="main-content" role="main">

  <!-- HERO SECTION -->
  <section class="premium-hero">
    <div class="premium-badge">
      <i class="fas fa-crown"></i> Premium Haryana LEET Sample Papers
    </div>
    <h1>Score <span>50+</span> in Haryana LEET<br>& Get Into Your Dream College</h1>
    <p class="hero-sub">
      14 exclusive, expertly crafted sample papers — questions completely different from the free ones.
      Serious preparation. Real results. All for just <strong style="color:#fcd34d;">₹11</strong>.
    </p>
    <div class="hero-cta-wrap">
      <a href="#pricing" class="btn-premium-cta primary">
        <i class="fas fa-crown"></i> Get Premium Access — ₹11
      </a>
      <a href="#why-choose" class="btn-premium-cta secondary">
        <i class="fas fa-info-circle"></i> Why Choose This?
      </a>
    </div>
  </section>

  <!-- WHY CHOOSE SECTION -->
  <section class="premium-section" id="why-choose">
    <h2 class="section-title">Why Choose Premium Papers?</h2>
    <p class="section-sub">Here's what makes our premium papers different from everything else out there</p>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon" style="background:#fef3c7;">🎯</div>
        <h3>100% Unique Questions</h3>
        <p>Every question is uniquely crafted — completely different from our free papers. You'll never see these questions anywhere else online.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon" style="background:#dcfce7;">📊</div>
        <h3>Exam-Level Difficulty</h3>
        <p>Questions are calibrated to the actual Haryana LEET exam difficulty. Practice at the right level so you're never surprised on exam day.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon" style="background:#dbeafe;">📚</div>
        <h3>Full Syllabus Coverage</h3>
        <p>All 14 papers cover the complete BTech LEET syllabus — Physics, Chemistry, Maths and Engineering topics, with emphasis on high-weightage areas.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon" style="background:#f3e8ff;">⚡</div>
        <h3>Score 50+ Guaranteed Path</h3>
        <p>Students who practice these 14 papers thoroughly report significantly better scores. The depth and variety of questions build real exam confidence.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon" style="background:#ecfdf5;">💸</div>
        <h3>Just ₹11 — Insanely Affordable</h3>
        <p>The cost of a single chai. Less than a bus ticket. ₹11 is all you invest for 5 premium papers that could change your engineering career.</p>
      </div>
    </div>
  </section>

  <!-- PAPER PREVIEW -->
  <section class="papers-section">
    <h2 class="section-title">14 Premium Sample Papers</h2>
    <p class="section-sub">Access all 14 papers instantly after payment</p>
    <div class="papers-grid">
      <!-- Section A -->
      <div class="paper-card section-a"><span class="section-tag">Section A</span><span class="paper-number">01</span><span class="paper-label">Sample Paper 1<br><small>Section A</small></span><i class="fas fa-lock paper-lock"></i></div>
      <div class="paper-card section-a"><span class="section-tag">Section A</span><span class="paper-number">02</span><span class="paper-label">Sample Paper 2<br><small>Section A</small></span><i class="fas fa-lock paper-lock"></i></div>
      <!-- Section B -->
      <div class="paper-card section-b"><span class="section-tag">Section B</span><span class="paper-number">03</span><span class="paper-label">Sample Paper 3<br><small>Section B</small></span><i class="fas fa-lock paper-lock"></i></div>
      <div class="paper-card section-b"><span class="section-tag">Section B</span><span class="paper-number">04</span><span class="paper-label">Sample Paper 4<br><small>Section B</small></span><i class="fas fa-lock paper-lock"></i></div>
      <!-- Section C -->
      <div class="paper-card section-c"><span class="section-tag">Section C</span><span class="paper-number">05</span><span class="paper-label">Sample Paper 5<br><small>Section C</small></span><i class="fas fa-lock paper-lock"></i></div>
      <div class="paper-card section-c"><span class="section-tag">Section C</span><span class="paper-number">06</span><span class="paper-label">Sample Paper 6<br><small>Section C</small></span><i class="fas fa-lock paper-lock"></i></div>
      <!-- Section D -->
      <div class="paper-card section-d"><span class="section-tag">Section D</span><span class="paper-number">07</span><span class="paper-label">Sample Paper 7<br><small>Section D</small></span><i class="fas fa-lock paper-lock"></i></div>
      <div class="paper-card section-d"><span class="section-tag">Section D</span><span class="paper-number">08</span><span class="paper-label">Sample Paper 8<br><small>Section D</small></span><i class="fas fa-lock paper-lock"></i></div>
      <!-- Complete Exam -->
