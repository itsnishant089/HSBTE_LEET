{
  "redirects": [
    {
      "source": "/html/:page.html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/:page.html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:page",
      "destination": "/html/:page.html"
    }
  ]
}
